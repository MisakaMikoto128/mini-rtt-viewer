import { AppTheme } from "theme.slint";
import { LineEdit, ListView } from "std-widgets.slint";

// 目标设备选择(单控件:输入即筛选 + 下拉候选),对齐原工程 EditableComboBox 观感。
// 候选弹层用官方 PopupWindow:渲染在窗口层,不会被面板里后续兄弟区块盖住
// (自绘 Rectangle 弹层会被 VerticalLayout 里后面的卡片遮挡,Slint 无 z-index)。
// 注意 Segoe UI 没有 ▸/▾(U+25B8/25BE)字形,会渲染成方框乱码;箭头一律用 ▼/▲。
export component DeviceSelect inherits Rectangle {
    in property <[string]> candidates;
    in property <bool> enabled: true;
    in-out property <string> text;
    // 输入变化 → Rust 端重筛候选(candidates 由 Rust 重建)
    callback filter-changed(string);
    height: AppTheme.ctrl-h;
    border-radius: AppTheme.radius;

    open := Rectangle { property <bool> opened: false; }

    HorizontalLayout {
        spacing: 0px;

        input := LineEdit {
            horizontal-stretch: 1;
            enabled: root.enabled;
            text <=> root.text;
            edited(t) => {
                root.filter-changed(t);
                if (!open.opened) {
                    popup.show();
                    open.opened = true;
                }
            }
            accepted(t) => {
                // Enter:取第一个候选(有则),并关弹层
                if (root.candidates.length > 0) {
                    root.text = root.candidates[0];
                }
                popup.close();
                open.opened = false;
            }
        }
        // 下拉按钮:与输入框拼成一个控件(同一背景、右侧窄条)
        Rectangle {
            width: 30px;
            background: AppTheme.input-bg;
            border-radius: 0px;
            drop-touch := TouchArea {
                clicked => {
                    if (!root.enabled) {
                        return;
                    }
                    if (open.opened) {
                        popup.close();
                        open.opened = false;
                    } else {
                        popup.show();
                        open.opened = true;
                    }
                }
                Rectangle {
                    border-radius: 0px;
                    background: drop-touch.has-hover ? AppTheme.hover-bg : transparent;
                    Text {
                        text: open.opened ? "▲" : "▼";
                        color: AppTheme.text-secondary;
                        font-size: 11px;
                        font-family: AppTheme.ui-font;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: root.width;
        height: min(root.candidates.length * 28px + 8px, 260px);

        Rectangle {
            background: AppTheme.card-bg;
            border-radius: AppTheme.radius;
            border-width: 1px;
            border-color: AppTheme.border-color;
            clip: true;

            if root.candidates.length == 0: Text {
                text: "无匹配候选(可直接输入型号)";
                color: AppTheme.text-muted;
                font-size: 11px;
                font-family: AppTheme.ui-font;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            ListView {
                visible: root.candidates.length > 0;
                for c in root.candidates: Rectangle {
                    height: 28px;
                    TA := TouchArea {
                        clicked => {
                            root.text = c;
                            popup.close();
                            open.opened = false;
                        }
                        Rectangle {
                            background: TA.has-hover ? AppTheme.hover-bg : transparent;
                            Text {
                                x: 8px;
                                width: parent.width - 12px;
                                text: c;
                                color: AppTheme.text-primary;
                                font-size: 12px;
                                font-family: AppTheme.ui-font;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }
        // 弹层关闭(点外部自动关)后同步开合标志
        changed visible => {
            if (!self.visible) {
                open.opened = false;
            }
        }
    }
}
