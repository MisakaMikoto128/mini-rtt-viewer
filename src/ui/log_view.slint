import { AppTheme } from "theme.slint";
import { ListView } from "std-widgets.slint";

// 一行日志里的一段同色文本
export struct LogRun {
    text: string,
    color: color,
}

// 一行日志 = 若干同色段(ANSI 转义由 Rust 端 vte 解析,这里只渲染)
export struct LogRow {
    runs: [LogRun],
}

// 日志滚动区:ListView 虚拟化(只渲染可见行,长日志不全量重排);
// 滚轮仍走自建的行高量化逻辑,直接驱动 ListView 的 viewport-y,
// 手动滚动位置永远落在行高网格上(逐屏上翻行位稳定,不抖动);
// 贴底跟随用显式 follow 标志(滚离底部失随、滚回底部恢复),新数据不拉扯视口。
export component LogView inherits Rectangle {
    in property <[LogRow]> rows;
    in property <int> row-count;      // 跟随逻辑的新行触发器
    // 自动滚动状态(follow 的对外呈现):滚离底部自动变 false,滚回底部/用户勾选变 true。
    // AppWindow 的「自动滚动」checkbox 与它 <=> 双向绑定——checkbox 是状态呈现也是开关。
    in-out property <bool> auto-scroll: true;
    background: AppTheme.log-bg;
    border-radius: AppTheme.radius;
    border-width: 1px;
    border-color: AppTheme.border-color;
    clip: true;

    // 内容总高(上下各 8px 内边距;每行严格一行高,天然行格对齐)
    private property <length> content-h: root.row-count * root.line-h + 16px;
    // 最大卷动量
    private property <length> max-offset: max(0px, content-h - self.height);
    // 手动滚动的行格上界:floor 到行高网格(自动贴底仍贴死 max-offset,
    // 从底部上翻第一格落进网格,底部只留不到一行的空隙)
    private property <length> grid-max: root.line-h > 0px
        ? floor(root.max-offset / root.line-h) * root.line-h
        : root.max-offset;
    // 顶部卷走量(手动滚动时永远为行高整数倍;= -viewport-y)
    private property <length> offset: 0px;
    // 滚轮/触摸板累积量(未量化;floor 取整后亚行残余自然保留在 raw 里,
    // 触摸板细粒度滚动凑满一行才动,滚轮大步长每格稳定前进整数行)
    private property <length> raw: 0px;
    // 本 tick 未夹紧的量化值(撞边界时用于检测并同步 raw)
    private property <length> u: 0px;
    // 贴底跟随:滚离底部失随(上翻不被新数据拉扯),滚回底部恢复
    private property <bool> follow: true;
    // 单行行高:同字体同字号的隐藏探针实测(字体渲染行高不能靠常数估);
    // 万一探针返回 0 则退回字号估值,保证滚动可用
    private property <length> line-fallback: AppTheme.log-font-size * 1.35;
    private property <length> line-h: probe.preferred-height > 0px
        ? probe.preferred-height : line-fallback;

    // 统一滚动入口:像素 delta 进入未量化累积量,floor 到行高网格后夹进范围。
    // 亚行残余留在 raw(触摸板细粒度凑满一行才动,滚轮每格稳定走整数行);
    // 撞边界时累积量直接对齐,反向滚动立即响应(不消化攒量)。
    function scroll-by-px(delta: length) {
        root.raw = root.raw - delta;
        root.u = floor(root.raw / root.line-h) * root.line-h;
        root.offset = min(max(root.u, 0px), root.grid-max);
        if (root.offset != root.u) {
            root.raw = root.offset;
        }
        root.follow = root.offset >= root.grid-max - 0.5px;
        root.auto-scroll = root.follow;
    }

    // 滚轮层在最上:拦截全部滚轮事件(不给下层 Flickable 原生像素滚动抢走),
    // 统一量化后驱动 viewport-y;鼠标拖选/复制在彩色行模型下不可用,无需放行
    wheel := TouchArea {
        width: 100%;
        height: 100%;
        scroll-event(e) => {
            if (root.line-h > 0px) {
                root.scroll-by-px(e.delta-y);
            }
            return EventResult.accept;
        }
    }

    // 行高探针:单行同字体文本(visible:false 不渲染,但属性仍可求值)
    probe := TextInput {
        visible: false;
        width: 60px;
        text: "Ag";
        font-family: AppTheme.mono-font;
        font-size: AppTheme.log-font-size;
    }

    list := ListView {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: parent.height - 16px;
        // offset 是我们量化的滚动量;Flickable 的原生滚动被顶层 wheel 屏蔽,
        // viewport-y 只会由这里驱动
        viewport-y: -root.offset;

        for row in root.rows: Rectangle {
            // 每行严格一行高:内容超高部分裁掉(终端语义;行内不换行)
            height: root.line-h;
            clip: true;
            HorizontalLayout {
                for run in row.runs: Text {
                    text: run.text;
                    color: run.color;
                    font-family: AppTheme.mono-font;
                    font-size: AppTheme.log-font-size;
                    vertical-alignment: center;
                    // 锁定固有宽度且不参与拉伸/压缩:总宽超出行宽时由行容器
                    // 从右侧整体裁切(否则长行会把中间的段挤窄、位置漂移)
                    width: self.preferred-width;
                    horizontal-stretch: 0;
                }
            }
        }
    }

    // 用户点击「自动滚动」checkbox:勾选=立即跳到底部并恢复跟随;
    // 取消=停在当前位置,新数据不再拉扯视口。
    // 滚动路径经由 scroll-by-px 同步 auto-scroll,两条路径在这里汇合成单一 follow 真源。
    changed auto-scroll => {
        root.follow = root.auto-scroll;
        if (root.auto-scroll) {
            root.offset = root.max-offset;
            root.raw = root.offset;
        }
    }

    // 新行追加:跟随者贴到新底部
    changed row-count => {
        if (root.follow) {
            root.offset = root.max-offset;
            root.raw = root.offset;
        }
    }
    // 内容变矮(清空/裁剪):夹回范围
    changed max-offset => {
        if (root.offset > root.max-offset) {
            root.offset = root.max-offset;
            root.raw = root.offset;
        }
    }
    // 视口高度变化(窗口拉伸/首帧布局):跟随者保持贴底
    changed height => {
        if (root.follow) {
            root.offset = root.max-offset;
            root.raw = root.offset;
        }
    }
}
