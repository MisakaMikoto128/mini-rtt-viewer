// 设计令牌唯一真源:所有组件从这里取值,不散落硬编码颜色。
// 主题 = 一组令牌取值(参考 SerialHub ADR-18 的"主题即令牌集"机制):
//   0 = 深色(默认)  1 = 浅色  2 = OLED 纯黑  3 = 护眼暖色
// 每 token 一行按主题索引取值,Slint 响应式自动全 UI 重绘。
export global AppTheme {
    // 主题索引(持久化在 prefs.theme;Rust 启动恢复后调 apply-color-scheme)
    in-out property <int> theme: 0;

    // 深色系判定(std 组件 Palette 配色 / 旧逻辑兼容):OLED 也算深色系
    out property <bool> dark: theme != 1 && theme != 3;

    // 强调色(沿用原项目 #28afe9,四主题通用)
    out property <color> accent: #28afe9;
    out property <color> accent-hover: #4fc1f5;
    out property <color> accent-press: #1c8cc4;

    // 背景层级
    out property <color> app-bg: theme == 1 ? #f2f3f5 : theme == 2 ? #000000 : theme == 3 ? #f5efdc : #1b1b1f;
    out property <color> panel-bg: theme == 1 ? #ffffff : theme == 2 ? #0a0a0a : theme == 3 ? #fbf7e8 : #222228;
    out property <color> card-bg: theme == 1 ? #eceef1 : theme == 2 ? #111114 : theme == 3 ? #efe8d2 : #2a2a31;
    out property <color> hover-bg: theme == 1 ? #dfe2e7 : theme == 2 ? #1c1c20 : theme == 3 ? #e8e0c8 : #34343c;
    out property <color> input-bg: theme == 1 ? #ffffff : theme == 2 ? #060608 : theme == 3 ? #fdf9ee : #26262c;

    // 日志区(深色沿用原项目 #222222 底 / #dddddd 字;其余按主题对比度配)
    out property <color> log-bg: theme == 1 ? #ffffff : theme == 2 ? #000000 : theme == 3 ? #faf5e4 : #222222;
    out property <color> log-fg: theme == 1 ? #222222 : theme == 2 ? #d8d8d8 : theme == 3 ? #4a3f2a : #dddddd;

    // 文本
    out property <color> text-primary: theme == 1 ? #1a1a1e : theme == 2 ? #e0e0e0 : theme == 3 ? #3d3322 : #e8e8ea;
    out property <color> text-secondary: theme == 1 ? #55555e : theme == 2 ? #909096 : theme == 3 ? #7a6c4f : #a0a0a8;
    out property <color> text-muted: theme == 1 ? #8a8a94 : theme == 2 ? #5c5c62 : theme == 3 ? #9a8c6c : #6a6a72;

    // 描边
    out property <color> border-color: theme == 1 ? #d0d3d9 : theme == 2 ? #26262c : theme == 3 ? #d8cfae : #3a3a42;

    // 状态色(深浅通用基色;橙/红按底色微调保可读)
    out property <color> ok-green: #2e7d32;
    out property <color> warn-orange: theme == 1 ? #d97706 : theme == 2 ? #ffa020 : theme == 3 ? #b0722a : #ff8c00;
    out property <color> err-red: theme == 1 ? #cc3344 : theme == 2 ? #ff5566 : theme == 3 ? #b34a44 : #cc4455;

    // 搜索高亮(VS Code 惯例:命中行淡黄,当前命中行橙)
    out property <color> search-hit-bg: theme == 1 ? #ffe08a66 : theme == 2 ? #b5890040 : theme == 3 ? #e8d08a80 : #b589002e;
    out property <color> search-current-bg: theme == 1 ? #ffb26673 : theme == 2 ? #ff8c0048 : theme == 3 ? #ffb26680 : #ff8c0038;

    // 尺寸
    out property <length> ctrl-h: 33px;
    out property <length> radius: 6px;
    out property <length> gap: 8px;
    out property <length> panel-w: 280px;

    // 字体
    out property <string> ui-font: "Segoe UI";
    out property <string> mono-font: "Consolas";
    out property <length> ui-font-size: 13px;
    // 日志字号可由 A-/A+ 按钮调节(行高探针随字号实测,滚动网格自动适应)
    in-out property <length> log-font-size: 13px;
}
